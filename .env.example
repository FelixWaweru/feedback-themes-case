# OpenRouter credentials and model selection
OPENROUTER_API_KEY=sk-or-...
# Model for per-review theme assignment (pipeline.py)
OPENROUTER_MODEL=moonshotai/kimi-k3
# Model for theme discovery + taxonomy synthesis (discover_themes.py)
OPENROUTER_THEME_MODEL=moonshotai/kimi-k3

# ---------------------------------------------------------------------------
# Prompt roots (optional). If unset, defaults from src/prompts.py are used.
# Use \n for newlines in a single-line value, or a quoted multiline string.
#
# Review assignment — system may include {taxonomy_block} (injected paths).
# If you omit {taxonomy_block}, the taxonomy is appended automatically.
# Review user template placeholders: {rating} {title} {content_en}
#
# Theme discovery user: {batch_size} {batch_reviews}
# Theme synthesis user: {candidates_json} {repair_section}
# ---------------------------------------------------------------------------

# PROMPT_REVIEW_SYSTEM_ROOT=You extract recurring customer-feedback themes...\n\n{taxonomy_block}\n\nReturn JSON matching the schema. Omit review_id.
# PROMPT_REVIEW_USER_TEMPLATE=Rating: {rating}\nTitle: {title}\nFeedback (English): {content_en}\n
# PROMPT_THEME_DISCOVERY_SYSTEM_ROOT=You invent recurring customer-feedback themes...
# PROMPT_THEME_DISCOVERY_USER_TEMPLATE=Batch of {batch_size} reviews:\n\n{batch_reviews}\n\nPropose up to 5 themes covering the main subjects in this batch.
# PROMPT_THEME_SYNTHESIS_SYSTEM_ROOT=You merge candidate three-tier feedback themes into one consistent taxonomy...
# PROMPT_THEME_SYNTHESIS_USER_TEMPLATE=Candidate themes from batch discovery:\n{candidates_json}\n\nSynthesize the final taxonomy JSON.\n{repair_section}
